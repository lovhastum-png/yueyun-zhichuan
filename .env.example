# ============================================================================
# 越韵智传 · 环境变量模板
# 用法：复制本文件为 .env，按实际环境填写；.env 已被 gitignore，切勿提交。
# 标注「可选」的项留空即可，系统会走内置默认值或自动降级。
# ============================================================================

# ---------- 基础运行 ----------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---------- 数据库（MySQL 8 / utf8mb4）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=yueyun_db
DB_POOL_SIZE=6

# ---------- 鉴权 ----------
# 长度需 >= 32；留空或仍为占位符时会自动生成随机密钥并写入 data/.jwt-secret
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES=7d

# ---------- 接口文档 ----------
# 生产环境默认关闭，需要 /api-docs 在线文档时设为 true
API_DOCS_ENABLE=false

# ---------- 跨域白名单（逗号分隔，可覆盖内置默认值）----------
CORS_ORIGINS=http://localhost:3000

# ---------- 讯飞星辰工作流 Agent（智能问答 / 丹青生图 / 多智能体）----------
# 申请地址：https://xingchen.xfyun.cn/ ；以下四项均为自有或经授权的凭证
XINGCHEN_AGENT_API_URL=https://xingchen-api.xf-yun.com/workflow/v1/chat/completions
XINGCHEN_AGENT_FLOW_ID=YOUR_FLOW_ID
XINGCHEN_AGENT_APP_ID=YOUR_APP_ID
XINGCHEN_AGENT_API_KEY=YOUR_API_KEY
XINGCHEN_AGENT_API_SECRET=YOUR_API_SECRET
XINGCHEN_AGENT_INPUT_KEY=AGENT_USER_INPUT
# 旧版 WebSocket 助手地址（可选，仅在走 wss 接入时填写）
XINGCHEN_AGENT_WS_URL=

# ---------- 音频识腔（阿里云百炼 qwen-omni / ASR）----------
QWEN_ASR_API_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/asr/transcription
QWEN_ASR_API_KEY=YOUR_API_KEY

# ---------- 丹青生图 ----------
# provider 可选：siliconflow（默认，Kolors）/ iflytek / dashscope / openai
IMAGE_GENERATION_PROVIDER=siliconflow
IMAGE_GENERATION_API_URL=https://api.siliconflow.cn/v1/images/generations
IMAGE_GENERATION_API_KEY=YOUR_API_KEY
IMAGE_GENERATION_API_SECRET=
IMAGE_GENERATION_APP_ID=
IMAGE_GENERATION_MODEL=Kwai-Kolors/Kolors

# ---------- 妙笔润色（提示词增强，可复用星辰三件套）----------
TEXT_LLM_ENABLE=true
TEXT_LLM_PROVIDER=iflytek
TEXT_LLM_API_URL=https://spark-api-open.xf-yun.com/v1/chat/completions
TEXT_LLM_API_KEY=YOUR_API_KEY
TEXT_LLM_API_SECRET=YOUR_API_SECRET
TEXT_LLM_MODEL=generalv3.5
# 是否优先走本地微调的越剧纠音模型
TEXT_LLM_USE_LOCAL_YUEJU=false

# ---------- 本地微调越剧模型（Qwen2.5-0.5B + LoRA，可选）----------
# serve.py 启动后监听该地址；未启动时相关功能自动降级到讯飞 Agent
YUEJU_LLM_LOCAL_URL=http://127.0.0.1:3456
YUEJU_CORRECT_URL=http://127.0.0.1:8004
YUEJU_CORRECT_START_CMD=
YUEJU_CORRECT_TIMEOUT_MS=30000
YUEJU_CORRECT_FORCE=false
YUEJU_KB_PATH=./data

# ---------- Python sidecar ----------
# 演唱测评（librosa / pyworld）
SINGING_EVAL_URL=http://127.0.0.1:8765
# 剧本比对（rapidfuzz / jieba / opencc）
SCRIPT_COMPARE_URL=http://127.0.0.1:8766
# 身段/姿态评估（可选）
POSE_EVAL_URL=http://127.0.0.1:8003
POSE_EVAL_WS_URL=
POSE_EVAL_MAX_SESSIONS=4
# 课程 PDF 导入 OCR 服务（可选）
PDF_IMPORT_OCR_URL=

# ---------- 站点预览（3D 舞台 / 村落预览）----------
PREVIEW_HOST=127.0.0.1
PREVIEW_PORT=4173
VILLAGE_PREVIEW_PORT=4174

# ---------- 外部学习平台对接（可选）----------
LEARNING_PLATFORM_API=
LEARNING_PLATFORM_KEY=

# ---------- 健康检查 / 熔断 ----------
API_HEALTH_ENABLE=true
API_HEALTH_FAILURES=3
API_HEALTH_WINDOW_MS=60000

# ---------- Cloudflare（可选，仅自动刷新 DNS 时需要）----------
CF_API_TOKEN=
CF_ZONE_ID=
