{
  "name": "yueyun-zhichuan",
  "version": "1.0.0",
  "description": "越韵智传 · 越剧教学辅助平台",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "build:3d-runtime": "esbuild source/3d-stage/runtime-entry.js --bundle --format=iife --global-name=Yueju3D --outfile=public/js/3d-stage-runtime.js --minify --target=es2020 --legal-comments=none",
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "version:static": "node scripts/bump-static-version.mjs",
    "deploy:purge": "node scripts/cloudflare-purge.cjs",
    "build:garden-rendering": "node scripts/build-garden-rendering.mjs"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "server/services/**/*.js",
      "server/utils/**/*.js",
      "server/middleware/**/*.js",
      "!server/**/index.js"
    ],
    "verbose": true
  },
  "dependencies": {
    "@fontsource/ma-shan-zheng": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.2.8",
    "@fontsource/zcool-xiaowei": "^5.3.0",
    "@pixiv/three-vrm": "3.5.5",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "iconv-lite": "^0.7.3",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "msedge-tts": "^2.0.7",
    "multer": "^2.0.0",
    "mysql2": "^3.11.0",
    "n8ao": "2.0.1",
    "pinyin-pro": "^3.29.3",
    "postprocessing": "6.37.8",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "swagger-ui-express": "^5.0.1",
    "three": "0.180.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "0.25.7",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "sharp": "^0.35.3",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
