[Unit]
Description=Yueyun Zhichuan web and API service
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=yueyun
Group=yueyun
WorkingDirectory=/opt/yueyun
EnvironmentFile=/opt/yueyun/.env
Environment=NODE_OPTIONS=--max-old-space-size=512
Environment=UV_THREADPOOL_SIZE=4
ExecStart=/usr/bin/node server/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
MemoryHigh=650M
MemoryMax=800M
TasksMax=256
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
